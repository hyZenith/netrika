# ==========================================
# Netrika Tele-Ophthalmology Environment Variables
# ==========================================

# 1. Neon PostgreSQL Database Connection URL
# Get this from your Neon Console: https://console.neon.tech
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. JWT Session Secret (for signing secure HttpOnly cookies)
# Generate a random 32+ character key, or leave to use secure development default
SESSION_SECRET="netrika-tele-ophthalmology-jwt-secret-key-2026-secure-token"

# 3. Cloudinary Image Storage (for high-resolution fundus scans and Grad-CAM maps)
# Get free from Cloudinary Console: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
